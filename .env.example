# 宿主机绑定地址：127.0.0.1 仅本机可用；0.0.0.0 供局域网其他设备（家人手机/电脑）访问
BIND_HOST=127.0.0.1
# 宿主机端口
HOST_PORT=8967
# 上游公网 API
API_BASE=https://index-translate.bilibili.com/v1
# 容器 DNS（规避宿主机 fake-ip 代理导致的上游不可达）
DNS_PRIMARY=223.5.5.5
DNS_SECONDARY=119.29.29.29
# 访问 Key，多个用逗号分隔；生成方式：echo "sk-it-$(openssl rand -hex 20)"
PROXY_API_KEYS=
